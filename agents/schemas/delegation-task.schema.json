{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tejaura.org/schemas/stage46/delegation-task.schema.json",
  "title": "TEJAURA Stage 4.6 Delegation Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "objective", "deliverable", "constraints"],
  "properties": {
    "project_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "objective": { "type": "string", "minLength": 3, "maxLength": 4000 },
    "deliverable": { "type": "string", "minLength": 2, "maxLength": 1000 },
    "constraints": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "project_context": { "type": "object" },
    "upstream_outputs": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "object" }
    },
    "requested_publish": { "type": "boolean" },
    "metrics": { "type": "object" },
    "code_workspace": { "type": "string", "maxLength": 512 },
    "files": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "content": { "type": "string", "maxLength": 200000 }
        }
      }
    },
    "test_command": {
      "type": "string",
      "enum": ["node --test", "python -m unittest", "pytest"]
    }
  }
}
