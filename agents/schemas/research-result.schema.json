{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tejaura.local/schemas/research-result.schema.json",
  "title": "Department Research Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "deliverables"],
  "properties": {
    "status": { "enum": ["completed", "failed", "blocked", "needs_approval"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "deliverables": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "content"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
          "content": { "type": "string", "maxLength": 20000 }
        }
      }
    },
    "model_assisted": { "type": "boolean" },
    "metadata": { "type": "object" }
  }
}
