{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tejaura.org/schemas/stage46/monitor-report.schema.json",
  "title": "TEJAURA Stage 4.6 Watchdog Monitor Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "alerts", "model_assisted"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_approval", "blocked", "failed"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "alerts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          },
          "code": { "type": "string", "minLength": 2, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "task_id": { "type": "string", "maxLength": 128 },
          "agent_id": { "type": "string", "maxLength": 128 },
          "worker_id": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "model_assisted": { "type": "boolean" },
    "metadata": { "type": "object" }
  }
}
