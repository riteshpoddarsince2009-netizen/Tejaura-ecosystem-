# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TEJAURA_AIRLLM_WORKER_TOKEN: Shared internal authentication token (>= 8 chars)
# between TypeScript RuntimeManager and the isolated Python AirLLM worker process.
# Never reuse this value as the owner password or secrets master key.
TEJAURA_AIRLLM_WORKER_TOKEN="REPLACE_WITH_LOCAL_RANDOM_TOKEN"

# TEJAURA_SECRETS_MASTER_KEY: High-entropy master key (>= 32 chars recommended)
# used for AES-256-GCM encryption of the Stage 2B identity store and secret vault.
# Never commit real values; owner passwords are never stored in .env files.
TEJAURA_SECRETS_MASTER_KEY="REPLACE_WITH_HIGH_ENTROPY_MASTER_KEY"

# TEJAURA_SANDBOX_PROVIDER: Sandbox adapter for delegated engineering execution.
# Production MUST use isolated_container_v1. mock_sandbox_v1 is development-only.
TEJAURA_SANDBOX_PROVIDER="isolated_container_v1"

# TEJAURA_CONTAINER_COMMAND: Docker CLI command used by the container sandbox.
# Use "sudo -n docker" only when the service account cannot access /var/run/docker.sock.
TEJAURA_CONTAINER_COMMAND="docker"

# TEJAURA_SANDBOX_IMAGE: Minimal image used for isolated test execution.
TEJAURA_SANDBOX_IMAGE="node:22-alpine"
