{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.0.0",
  "system": {
    "name": "TEJAURA",
    "version": "0.1.0",
    "stage": "stage-0-foundation",
    "status": "specification-only",
    "description": "Human-governed, modular, open-source-first AI operating system."
  },
  "principles": {
    "openSourceFirst": true,
    "modelProviderAgnostic": true,
    "phoneFirst": true,
    "freeFirst": true,
    "modularAndTestable": true
  },
  "governance": {
    "humanOwnerControl": true,
    "allowAgentSelfPermission": false,
    "allowAgentSelfApproval": false,
    "failClosedOnPolicyError": true,
    "defaultAutonomyLevel": "L1",
    "maxAutonomousLevel": "L2",
    "autonomyLevels": {
      "L0": {
        "id": "observe_only",
        "description": "Read-only inspection and reasoning with zero mutations."
      },
      "L1": {
        "id": "propose_only",
        "description": "Draft plans and proposals requiring owner confirmation to apply."
      },
      "L2": {
        "id": "bounded_local",
        "description": "Reversible, sandboxed local execution within pre-approved scope."
      },
      "L3": {
        "id": "supervised_action",
        "description": "External or side-effecting actions requiring explicit owner approval."
      },
      "L4": {
        "id": "owner_exclusive",
        "description": "Critical actions locked exclusively to explicit human owner approval and execution."
      }
    },
    "documents": {
      "constitution": "core/constitution/TEJAURA_CONSTITUTION.md",
      "identity": "core/identity/IDENTITY.md",
      "permissionPolicy": "core/permissions/PERMISSION_POLICY.md"
    }
  },
  "approvalGates": {
    "productionDeployments": {
      "required": true,
      "autonomyLevel": "L4",
      "allowAutoApprove": false
    },
    "paymentsAndBilling": {
      "required": true,
      "autonomyLevel": "L4",
      "allowAutoApprove": false
    },
    "publicPublishing": {
      "required": true,
      "autonomyLevel": "L4",
      "allowAutoApprove": false
    },
    "governanceModification": {
      "required": true,
      "autonomyLevel": "L4",
      "allowAutoApprove": false
    },
    "credentialAccess": {
      "required": true,
      "autonomyLevel": "L4",
      "allowAutoApprove": false
    },
    "destructiveActions": {
      "required": true,
      "autonomyLevel": "L4",
      "allowAutoApprove": false
    }
  },
  "security": {
    "allowSecretsInSource": false,
    "allowSecretsInConfig": false,
    "credentialSource": "environment-variables-only",
    "defaultNetworkEgress": "deny",
    "auditTrail": {
      "enabled": false,
      "status": "planned"
    }
  },
  "intelligence": {
    "modelRegistryPath": "intelligence/model-registry/models.json",
    "modelRegistryRulesPath": "intelligence/model-registry/README.md",
    "requireRegisteredModelsOnly": true,
    "preferLocalOrFreeModels": true
  },
  "modules": {
    "core": {
      "status": "implemented-spec",
      "description": "Constitution, identity, permission policy, and initial system configuration."
    },
    "intelligence": {
      "status": "implemented-spec",
      "description": "Versioned empty model registry and registration rules."
    },
    "docs": {
      "status": "implemented-spec",
      "description": "System architecture and staged development roadmap."
    },
    "runtime": {
      "status": "planned",
      "description": "Policy evaluator, approval queue, and sandboxed task runner."
    },
    "interfaces": {
      "status": "planned",
      "description": "Phone-first owner control plane and CLI."
    },
    "adapters": {
      "status": "planned",
      "description": "Provider-agnostic model and tool adapters."
    }
  }
}
